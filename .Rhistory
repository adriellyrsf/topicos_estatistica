install.packages("lme4")
#Antes de tudo, é necessario converter a variavél 'tipo_de_dia' pois ela é qualitativa.
dados$tipo_de_dia <- as.factor(dados$tipo_de_dia)
modelo_misto <- lmer(
burnout_escore ~ tipo_de_dia +
horas_de_trabalho +
horas_de_tempo_de_tela +
quantidade_de_reunioes +
pausas_tomadas +
horas_dormidas +
taxa_de_conclusao_de_tarefas +
trabalho_apos_o_horario +
(1 | id_usuario),
data = dados
)
library(knitr)
library(ggplot2)
library(dplyr)
library(tidyr)
library(kableExtra)
library(car)
library(MASS)
library(stringr)
library(readr)
library(lme4)
#Antes de tudo, é necessario converter a variavél 'tipo_de_dia' pois ela é qualitativa.
dados$tipo_de_dia <- as.factor(dados$tipo_de_dia)
modelo_misto <- lmer(
burnout_escore ~ tipo_de_dia +
horas_de_trabalho +
horas_de_tempo_de_tela +
quantidade_de_reunioes +
pausas_tomadas +
horas_dormidas +
taxa_de_conclusao_de_tarefas +
trabalho_apos_o_horario +
(1 | id_usuario),
data = dados
)
summary(modelo_misto)
modelo_misto <- lmer(
burnout_escore ~ tipo_de_dia +
horas_de_trabalho +
horas_de_tempo_de_tela +
quantidade_de_reunioes +
pausas_tomadas +
horas_dormidas +
taxa_de_conclusao_de_tarefas +
trabalho_apos_o_horario +
(1 | id_usuario),
data = dados
)
#Antes de tudo, é necessario converter a variavél 'tipo_de_dia' pois ela é qualitativa.
dados$tipo_de_dia <- as.factor(dados$tipo_de_dia)
dados <- dados %>%
group_by(id_usuario) %>%
mutate(
horas_trab_media = mean(horas_de_trabalho),
horas_trab_centrada = horas_de_trabalho - horas_trab_media
)
modelo_misto <- lmer(
burnout_escore ~ tipo_de_dia +
horas_de_trabalho +
horas_de_tempo_de_tela +
quantidade_de_reunioes +
pausas_tomadas +
horas_dormidas +
taxa_de_conclusao_de_tarefas +
trabalho_apos_o_horario +
(1 | id_usuario),
data = dados
)
summary(modelo_misto)
